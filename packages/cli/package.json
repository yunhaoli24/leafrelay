{
  "name": "leafrelay",
  "version": "0.2.0",
  "description": "Reliable two-way synchronization between Overleaf and a local directory.",
  "keywords": [
    "overleaf",
    "latex",
    "sync",
    "cli",
    "collaboration"
  ],
  "type": "module",
  "bin": {
    "leafrelay": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "yunhaoli24",
    "url": "https://github.com/yunhaoli24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yunhaoli24/leafrelay"
  },
  "bugs": {
    "url": "https://github.com/yunhaoli24/leafrelay/issues"
  },
  "homepage": "https://github.com/yunhaoli24/leafrelay#readme",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "8.6.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "diff-match-patch": "^1.0.5",
    "mime": "4.1.0",
    "minimatch": "^10.2.6",
    "node-diff3": "^3.2.1",
    "uuid": "^14.0.1",
    "vscode-jsonrpc": "9.0.1"
  },
  "devDependencies": {
    "@leafrelay/core": "workspace:*",
    "@leafrelay/daemon": "workspace:*",
    "@leafrelay/protocol": "workspace:*"
  }
}
