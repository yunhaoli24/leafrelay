{
  "name": "leafrelay-workspace",
  "version": "0.1.6",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf apps/vscode/out apps/vscode/views/chat-view/dist packages/core/dist packages/cli/dist",
    "build:core": "pnpm --filter @leafrelay/core run build",
    "build:vscode": "pnpm run build:core && pnpm --dir apps/vscode run build",
    "build:cli": "pnpm run build:core && pnpm --dir packages/cli run build",
    "compile": "pnpm run clean && pnpm run build:core && pnpm --dir apps/vscode run build && pnpm --dir packages/cli run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint apps/vscode/src apps/vscode/test apps/vscode/views/chat-view/src apps/vscode/views/chat-view/*.ts packages --ext ts --no-warn-ignored",
    "pretest": "pnpm run compile && pnpm run lint",
    "test": "vitest run --config vitest.config.mjs",
    "test:extension": "vscode-test",
    "test:overleaf": "node test/integration/overleaf.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/fuzzysearch": "^1.0.2",
    "@types/node": "26.2.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "download-cli": "^1.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
